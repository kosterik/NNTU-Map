<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Пары на завтра"
            android:textColor="#F0F6FC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_group_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="23-ИВТ-1"
            android:textColor="#58A6FF"
            android:textSize="10sp"
            android:background="#161B22"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#30363D"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/widget_content_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="Загрузка расписания..."
        android:textColor="#8B949E"
        android:textSize="11sp"
        android:lineSpacingExtra="3dp" />

</LinearLayout>
